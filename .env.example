# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Username бота (без @) — нужен для формирования ссылок вида t.me/BOT_USERNAME?start=group1
BOT_USERNAME=zeus_partsreg_bot

COMPANY_NAME=ZEVS PARTS

# ID гугл-таблицы (из ссылки: https://docs.google.com/spreadsheets/d/ЭТОТ_ID/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB=Заявки
GOOGLE_CREDENTIALS_FILE=credentials.json
# Для Railway/облака удобнее не файл, а весь JSON-ключ одной строкой:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...", ...}

# 2 кнопки для связи с менеджером напрямую — Telegram Володимира и Олександра
MANAGER_1_TELEGRAM_URL=https://t.me/volodymyr_zevsparts
MANAGER_2_TELEGRAM_URL=https://t.me/alexandro_zevs_parts
