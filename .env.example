# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Username бота (без @) — нужен для формирования ссылок вида t.me/BOT_USERNAME?start=group1
BOT_USERNAME=zeus_partsreg_bot

COMPANY_NAME=ZEVS PARTS

# KeyCRM — API-ключ (Настройки → API в KeyCRM)
KEYCRM_API_TOKEN=your_keycrm_api_token_here

# ID воронки в KeyCRM, куда будут падать заявки (необязательно —
# без него заявки попадут в первую воронку по умолчанию)
KEYCRM_PIPELINE_ID=

# ID источника в KeyCRM (необязательно, но удобно, чтобы видеть,
# что заявка пришла именно из Telegram-бота): Настройки → Источники
KEYCRM_SOURCE_ID=

# ID ответственного менеджера в KeyCRM (необязательно)
KEYCRM_MANAGER_ID=

# Кнопка со ссылкой на группу Telegram (вместо кнопок менеджеров)
GROUP_URL=https://t.me/+NoAgrHxYygA0Y2Ey

# Facebook Conversions API — отправляет данные о заявке обратно в Facebook,
# чтобы реклама оптимизировалась по конверсиям. Работает только для заявок,
# пришедших по рекламным ссылкам (?start=ads...). Если оставить пустым —
# бот просто не будет отправлять данные в Facebook, ничего не сломается.
#
# FB_PIXEL_ID — Events Manager → выбрать пиксель → скопировать ID (или "Dataset ID")
# FB_ACCESS_TOKEN — там же: Settings → Conversions API → Generate Access Token
FB_PIXEL_ID=
FB_ACCESS_TOKEN=
# FB_TEST_EVENT_CODE — только для проверки в разделе "Test Events" в Events Manager,
# на боевом режиме оставить пустым
FB_TEST_EVENT_CODE=

# Уведомления о новых карточках в воронке — отдельный чат в Telegram
# и ОТДЕЛЬНЫЙ бот специально для сотрудников (не тот, что видят клиенты).
# Настраивается через notify_server.py (второй, отдельный процесс — Web-сервис в Railway).
#
# NOTIFY_BOT_TOKEN — токен нового бота для сотрудников (создайте у @BotFather
# отдельно от клиентского бота — например, "zevs_staff_bot")
NOTIFY_BOT_TOKEN=

# NOTIFY_CHAT_ID — числовой ID нового Telegram-чата, куда слать уведомления
# (см. инструкцию в README, раздел "Уведомления о новых карточках")
NOTIFY_CHAT_ID=

# WEBHOOK_SECRET — произвольный секретный пароль (придумайте сами, любая строка),
# добавляется в URL вебхука как ?secret=ВАШ_ПАРОЛЬ — защищает от посторонних
# запросов на этот адрес
WEBHOOK_SECRET=
